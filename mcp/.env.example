# Copy to mcp/.env (never commit). Claude Desktop / Cursor read these from the
# MCP server config's `env` block — this file is for local `npm start` / checks.

# --- required: project URL ---------------------------------------------------
# From Supabase → Project Settings → API
ZEROED_SUPABASE_URL=https://your-project-id.supabase.co

# --- auth: pick ONE of the two modes ----------------------------------------
#
# 1) Athlete login (preferred). Uses the same RLS as the app — you can only
#    read and write your own rows.
ZEROED_SUPABASE_ANON_KEY=your-anon-key
ZEROED_EMAIL=you@example.com
ZEROED_PASSWORD=your-app-password
#
# 2) Service role (personal machine only). Bypasses RLS, so you MUST also
#    name the athlete. Never paste this key into a shared MCP config.
# ZEROED_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# ZEROED_ATHLETE_EMAIL=you@example.com
# ZEROED_ATHLETE_ID=

# Optional. lb (default) or kg — used when formatting logged sets.
ZEROED_WEIGHT_UNIT=lb
