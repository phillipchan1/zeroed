# Supabase Edge Function secrets — LOCAL DEV ONLY
# Copy to `supabase/functions/.env` (gitignored) and fill in real values, then run:
#   supabase functions serve --env-file supabase/functions/.env
#
# For PRODUCTION, do NOT use this file — set the secret on the linked project:
#   supabase secrets set OPENAI_API_KEY=sk-...
#
# This key is SERVER-ONLY. It must never be VITE_-prefixed and never reach the
# frontend bundle or Vercel. The browser calls the function via
# supabase.functions.invoke(...) carrying the user's JWT — never the key.

OPENAI_API_KEY=sk-replace-me
