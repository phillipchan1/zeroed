require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '15.0'
use_frameworks!

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorHaptics', :path => '../../node_modules/@capacitor/haptics'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)
  # Unique pod ids so frameworks stay distinct from the app target.
  installer.pods_project.targets.each do |target|
    slug = target.name.gsub(/[^A-Za-z0-9.-]/, '-')
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      config.build_settings['PRODUCT_BUNDLE_IDENTIFIER'] = "org.cocoapods.#{slug}"
      # Pods are re-signed when the app embeds them. Letting them sign
      # themselves makes a fresh CI runner ask for an iOS Development
      # certificate, and that account is already at Apple's cap.
      config.build_settings['CODE_SIGNING_ALLOWED'] = 'NO'
    end
  end
end
