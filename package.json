{
  "name": "zeroed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "deploy:db": "supabase db push",
    "deploy:agent": "supabase functions deploy agent",
    "deploy:backend": "supabase db push && supabase functions deploy agent",
    "mcp": "npm --prefix mcp start",
    "mcp:install": "npm --prefix mcp install",
    "mcp:check": "npm --prefix mcp run check",
    "check": "for f in src/engine/*.check.ts src/lib/*.check.ts; do node --experimental-strip-types \"$f\" || exit 1; done"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@supabase/supabase-js": "^2.47.0",
    "lucide-react": "^1.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
