{
  "name": "zeroed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "lint": "eslint worker/src src/lib/api.ts src/lib/dataClient.ts src/lib/supabaseClient.ts src/lib/authClient.ts src/hooks/useAuth.ts src/screens/funnel/AuthScreen.tsx src/screens/onboarding/AuthSheet.tsx src/engine/agentClient.ts src/lib/useOnline.ts src/screens/loop/ProfileScreen.tsx src/screens/onboarding/OnboardingRouter.tsx scripts/migrate-users.lib.mjs scripts/migrate-supabase-to-neon.mjs scripts/prove-migrate-users.mjs scripts/prove-isolation-mutation.mjs scripts/prove-client-data-gate.mjs scripts/smoke-wrangler-data.mjs scripts/prove-better-auth-schema.mjs scripts/prove-postgres.mjs scripts/prove-workerd-auth.mjs --max-warnings=0",
    "deploy:db": "supabase db push",
    "deploy:agent": "supabase functions deploy agent",
    "deploy:backend": "supabase db push && supabase functions deploy agent",
    "cf:dev": "npm run build && wrangler dev",
    "cf:deploy": "npm run build && wrangler deploy",
    "mcp": "npm --prefix mcp start",
    "mcp:install": "npm --prefix mcp install",
    "mcp:check": "npm --prefix mcp run check",
    "check": "for f in src/engine/*.check.ts src/lib/*.check.ts worker/src/*.check.ts; do node --experimental-strip-types \"$f\" || exit 1; done",
    "check:isolation-mutation": "node scripts/prove-isolation-mutation.mjs",
    "check:client-data-gate": "node scripts/prove-client-data-gate.mjs",
    "check:better-auth-schema": "node --experimental-strip-types scripts/prove-better-auth-schema.mjs",
    "check:postgres": "node --experimental-strip-types scripts/prove-postgres.mjs",
    "check:workerd-auth": "node --experimental-strip-types scripts/prove-workerd-auth.mjs",
    "smoke:wrangler-data": "node scripts/smoke-wrangler-data.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:check": "node scripts/ios-project-check.mjs",
    "ios:check:ipa": "node scripts/ios-check-ipa-bundle-ids.mjs --self-test"
  },
  "dependencies": {
    "@capacitor/core": "^6.2.0",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.2.2",
    "@supabase/supabase-js": "^2.47.0",
    "better-auth": "^1.3.34",
    "hono": "^4.10.4",
    "lucide-react": "^1.17.0",
    "pg": "^8.16.3",
    "postgres": "^3.4.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.15.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@cloudflare/workers-types": "5.20261025.1",
    "@electric-sql/pglite": "^0.3.14",
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.1",
    "globals": "^17.13.0",
    "playwright": "^1.62.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.46.2",
    "vite": "^6.0.5",
    "wrangler": "^4.45.0"
  }
}
